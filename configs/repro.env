# 可复现的刚性位姿实验配置。
# Linux 加载方式：set -a; source configs/repro.env; set +a
# PowerShell 请使用 $env:NAME="value" 设置相同变量。

# ---------------------------------------------------------------------------
# 病例选择和标准根目录
# ---------------------------------------------------------------------------
PATIENT_ID=Patient1
FRAME_ID=02
# 可选的根目录覆盖项：
# AR_PROJECT_ROOT=/workspace/AR
# DATA_ROOT=/workspace/AR/src_data
# CASE_ROOT=/workspace/AR/data_case
# RESULT_ROOT=/workspace/AR/result
# WEIGHTS_ROOT=/workspace/AR/weights
# AR_ANNOTATOR=koo

# ---------------------------------------------------------------------------
# 共享输入契约
# 修改分辨率或轮廓线宽后，已有病例数据、训练样本和 checkpoint 均不再兼容。
# 修改后必须重新运行 scripts 01-06。
# ---------------------------------------------------------------------------
AR_WORK_WIDTH=480
AR_WORK_HEIGHT=270
AR_CONTOUR_THICKNESS=2
AR_SEED=42

# ---------------------------------------------------------------------------
# Script 01b / scripts 05 和 07：人工掩码质量门槛
# 比例均相对于工作图像或完整肝脏掩码。这些检查用于拒绝空掩码、碎裂掩码、
# 面积异常掩码、过期掩码或深度覆盖不足的掩码。
# 收紧阈值可能使已有标注或深度失效。
# ---------------------------------------------------------------------------
AR_FULL_MASK_MIN_RATIO=0.05
AR_FULL_MASK_MAX_RATIO=0.95
AR_FULL_MASK_LARGEST_COMPONENT_MIN=0.95
AR_DEPTH_VALID_TO_FULL_MIN=0.10
AR_DEPTH_COVERAGE_MIN=0.95

# ---------------------------------------------------------------------------
# Script 02：初始 object-to-camera 位姿
# 平移单位为 mm；旋转使用 Euler 角（degree），并由
# shared.pose_render.euler_to_matrix 按 Rz @ Ry @ Rx 应用。
# data_case/<patient>/<frame>/initial_pose.json 可以提供这些值；
# 显式环境变量的优先级高于该文件。
# ---------------------------------------------------------------------------
# AR_TVIEW_TX=6.0
# AR_TVIEW_TY=27.0
# AR_TVIEW_TZ=110.0
# AR_TVIEW_RX=45.0
# AR_TVIEW_RY=-10.0
# AR_TVIEW_RZ=50.0
# AR_TVIEW_CONFIG=/workspace/AR/data_case/Patient1/02/initial_pose.json

# ---------------------------------------------------------------------------
# Script 03：显式训练配对生成
# base_to_target 配对用于学习从初始位姿开始的粗修正。
# local_refine 配对用于学习采样目标位姿附近的小范围修正。
# ---------------------------------------------------------------------------
AR_NUM_SAMPLES=5000
AR_TRAIN_RATIO=0.9
AR_TRANS_RANGE_MM=50.0
AR_ROT_RANGE_DEG=20.0
AR_LOCAL_TRANS_RANGE_MM=5.0
AR_LOCAL_ROT_RANGE_DEG=3.0
AR_LOCAL_REFINE_RATIO=0.7
# 设为 0 时使用 NUM_SAMPLES * 50 次尝试上限。
AR_MAX_ATTEMPTS=0

# ---------------------------------------------------------------------------
# Script 06：训练
# 默认从头开始训练。只有已有 checkpoint 使用相同数据和关键配置生成时，
# 才可设置 AR_RESUME=1。
# ---------------------------------------------------------------------------
AR_BATCH_SIZE=32
AR_NUM_EPOCHS=50
AR_NUM_WORKERS=4
AR_RESUME=0

# ---------------------------------------------------------------------------
# Script 07：已验证的默认推理策略
# 默认最终输出为最后一个安全接受的位姿。轮廓/mask proxy 分数仅用于诊断；
# 除非显式开启未验证控制项的消融开关，否则不能用于控制最终选择。
# ---------------------------------------------------------------------------
AR_WEIGHT_PATH=/workspace/AR/weights/refinenet_patient1_02_best.pth
# 仅在未设置 AR_WEIGHT_PATH，且当前帧不存在 checkpoints/best.pth 时使用。
# AR_PRETRAINED_WEIGHT_PATH=/workspace/AR/weights/refinenet_patient1_02_best.pth
AR_INFER_PROFILE=paper_translation_stop1mm_last
AR_UPDATE_MODE=right
AR_MAX_ITER=10
AR_STOP_TRANS_MM=1.0

# 第一次实际更新系数 = 基础 damping * 首步 damping = 0.4 * 0.75 = 0.30。
AR_TRANS_DAMPING=0.4
AR_ROT_DAMPING=0.4
AR_FIRST_STEP_DAMPING=0.75
AR_REFINE_TRANS_DAMPING=0.1
AR_REFINE_ROT_DAMPING=0.1

# 硬性发散保护。值为 0 只会关闭可选的单步/漂移保护，不会关闭原始偏移和
# 总位姿发散检查。
AR_MAX_STEP_TRANS_MM=0.0
AR_MAX_STEP_ROT_DEG=0.0
AR_DIVERGE_RAW_TRANS_MM=120.0
AR_DIVERGE_RAW_ROT_DEG=45.0
AR_DIVERGE_POSE_TRANS_MM=200.0
AR_STOP_DRIFT_MM=0.0

# 已验证的默认 profile 会关闭所有 proxy 控制项。
AR_SELECT_BEST_BY=last
AR_ACCEPT_BY_SCORE=0
AR_SCORE_PATIENCE=0
AR_RAW_WORSEN_PATIENCE=0
AR_RAW_WORSEN_MIN_DELTA=0.5
AR_RAW_SCORE_ROT_WEIGHT=5.0
AR_SCORE_ACCEPT_TOL=0.0
AR_ALLOW_UNVALIDATED_SCORE_CONTROL=0

# 图像空间 proxy 分数参数。在默认 profile 中仅用于诊断，并不是经过验证的
# TRE 替代指标。
AR_CONTOUR_SCORE_MAX_DIST_PX=50.0
AR_CONTOUR_SCORE_MASK_WEIGHT=20.0

# 缺少真实帧深度时直接报错。仅在明确执行缺失模态消融时开启，正常运行不得开启。
AR_ALLOW_ZERO_DEPTH=0

# ---------------------------------------------------------------------------
# Depth Anything V2
# ---------------------------------------------------------------------------
DA2_PROJECT_DIR=/workspace/AR/src
DA2_ENCODER=vitl
DA2_INPUT_SIZE=518
DA2_CHECKPOINT_PATH=/workspace/AR/weights/depth_anything_v2_vitl.pth
