# Reproducible rigid-pose experiment configuration.
# Load in Linux with: set -a; source configs/repro.env; set +a
# PowerShell users should set the same variables with $env:NAME="value".

# ---------------------------------------------------------------------------
# Case selection and canonical roots
# ---------------------------------------------------------------------------
PATIENT_ID=Patient1
FRAME_ID=02
# Optional root overrides:
# AR_PROJECT_ROOT=/workspace/AR
# DATA_ROOT=/workspace/AR/src_data
# CASE_ROOT=/workspace/AR/data_case
# RESULT_ROOT=/workspace/AR/result
# WEIGHTS_ROOT=/workspace/AR/weights
# AR_ANNOTATOR=koo

# ---------------------------------------------------------------------------
# Shared input contract
# Changing resolution or contour thickness invalidates generated case data,
# training samples, and checkpoints. Regenerate scripts 01-06 after a change.
# ---------------------------------------------------------------------------
AR_WORK_WIDTH=480
AR_WORK_HEIGHT=270
AR_CONTOUR_THICKNESS=2
AR_SEED=42

# ---------------------------------------------------------------------------
# Script 01b / scripts 05 and 07: manual-mask quality gates
# Ratios are relative to the working image or full-liver mask. These checks
# reject empty, fragmented, implausibly large, stale, or weakly covered masks.
# Tightening a threshold may invalidate existing annotations/depth.
# ---------------------------------------------------------------------------
AR_FULL_MASK_MIN_RATIO=0.05
AR_FULL_MASK_MAX_RATIO=0.95
AR_FULL_MASK_LARGEST_COMPONENT_MIN=0.95
AR_DEPTH_VALID_TO_FULL_MIN=0.10
AR_DEPTH_COVERAGE_MIN=0.95

# ---------------------------------------------------------------------------
# Script 02: initial object-to-camera pose
# Translation is millimetres. Rotation is Euler degrees, applied by
# shared.pose_render.euler_to_matrix as Rz @ Ry @ Rx.
# A data_case/<patient>/<frame>/initial_pose.json file may provide these values;
# explicit environment variables override that file.
# ---------------------------------------------------------------------------
# AR_TVIEW_TX=6.0
# AR_TVIEW_TY=27.0
# AR_TVIEW_TZ=110.0
# AR_TVIEW_RX=45.0
# AR_TVIEW_RY=-10.0
# AR_TVIEW_RZ=50.0
# AR_TVIEW_CONFIG=/workspace/AR/data_case/Patient1/02/initial_pose.json

# ---------------------------------------------------------------------------
# Script 03: explicit training-pair generation
# base_to_target pairs teach coarse correction from the initial pose.
# local_refine pairs teach small correction near a sampled target pose.
# ---------------------------------------------------------------------------
AR_NUM_SAMPLES=5000
AR_TRAIN_RATIO=0.9
AR_TRANS_RANGE_MM=50.0
AR_ROT_RANGE_DEG=20.0
AR_LOCAL_TRANS_RANGE_MM=5.0
AR_LOCAL_ROT_RANGE_DEG=3.0
AR_LOCAL_REFINE_RATIO=0.7
# 0 means NUM_SAMPLES * 50 attempts.
AR_MAX_ATTEMPTS=0

# ---------------------------------------------------------------------------
# Script 06: training
# Training starts fresh by default. Set AR_RESUME=1 only when the existing
# checkpoint was produced with the same data and important configuration.
# ---------------------------------------------------------------------------
AR_BATCH_SIZE=32
AR_NUM_EPOCHS=50
AR_NUM_WORKERS=4
AR_RESUME=0

# ---------------------------------------------------------------------------
# Script 07: validated default inference policy
# The default final output is the last safe accepted pose. Contour/mask proxy
# scores are diagnostic only and cannot control selection unless the explicit
# unsafe-ablation switch is enabled.
# ---------------------------------------------------------------------------
AR_WEIGHT_PATH=/workspace/AR/weights/refinenet_patient1_02_best.pth
# Used only when AR_WEIGHT_PATH is unset and no per-frame checkpoints/best.pth
# exists.
# AR_PRETRAINED_WEIGHT_PATH=/workspace/AR/weights/refinenet_patient1_02_best.pth
AR_INFER_PROFILE=paper_translation_stop1mm_last
AR_UPDATE_MODE=right
AR_MAX_ITER=10
AR_STOP_TRANS_MM=1.0

# First applied step = base damping * first-step damping = 0.4 * 0.75 = 0.30.
AR_TRANS_DAMPING=0.4
AR_ROT_DAMPING=0.4
AR_FIRST_STEP_DAMPING=0.75
AR_REFINE_TRANS_DAMPING=0.1
AR_REFINE_ROT_DAMPING=0.1

# Hard divergence guards. A value of 0 disables only the optional step/drift
# guards, never the raw-offset and total-pose divergence checks.
AR_MAX_STEP_TRANS_MM=0.0
AR_MAX_STEP_ROT_DEG=0.0
AR_DIVERGE_RAW_TRANS_MM=120.0
AR_DIVERGE_RAW_ROT_DEG=45.0
AR_DIVERGE_POSE_TRANS_MM=200.0
AR_STOP_DRIFT_MM=0.0

# Proxy controls are disabled in the validated default profile.
AR_SELECT_BEST_BY=last
AR_ACCEPT_BY_SCORE=0
AR_SCORE_PATIENCE=0
AR_RAW_WORSEN_PATIENCE=0
AR_RAW_WORSEN_MIN_DELTA=0.5
AR_RAW_SCORE_ROT_WEIGHT=5.0
AR_SCORE_ACCEPT_TOL=0.0
AR_ALLOW_UNVALIDATED_SCORE_CONTROL=0

# Image-space proxy score parameters. They are diagnostic-only in the default
# profile and are not validated TRE surrogates.
AR_CONTOUR_SCORE_MAX_DIST_PX=50.0
AR_CONTOUR_SCORE_MASK_WEIGHT=20.0

# Missing real-frame depth is a hard error. Enable only for a deliberate
# missing-modality ablation, never for a normal run.
AR_ALLOW_ZERO_DEPTH=0

# ---------------------------------------------------------------------------
# Depth Anything V2
# ---------------------------------------------------------------------------
DA2_PROJECT_DIR=/workspace/AR/src
DA2_ENCODER=vitl
DA2_INPUT_SIZE=518
DA2_CHECKPOINT_PATH=/workspace/AR/weights/depth_anything_v2_vitl.pth
